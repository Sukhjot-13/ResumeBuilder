# Resume Builder: copy to .env.local. Never commit real credentials.
# Full required/optional lists and task overrides: README.md.

# Required at boot; generate each signing secret separately with openssl rand -hex 32.
MONGODB_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Required for normal OTP login. Use a verified Brevo sender address.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI defaults: deepseek:deepseek-flash (V4.1 Flash); Gemini needs task overrides.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# AI_TASK_RESUME_GENERATION=gemini:YOUR_SUPPORTED_MODEL_ID
# AI_TASK_COVER_LETTER_GENERATION=gemini:YOUR_SUPPORTED_MODEL_ID
# AI_TASK_AI_EDIT=gemini:YOUR_SUPPORTED_MODEL_ID
# AI_TASK_RESUME_PARSING=gemini:YOUR_SUPPORTED_MODEL_ID
# AI_TASK_GATEKEEPER=gemini:YOUR_SUPPORTED_MODEL_ID

# Optional billing and extra trusted CSRF origins.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ALLOWED_ORIGINS=

# Optional Manager integration. Each key must belong to the resume-builder project.
# MANAGER_ENDPOINT=https://your-manager-host
# MANAGER_APP_ID=resume-builder
# MANAGER_LOG_KEY=mlk_REPLACE_ME
# MANAGER_ANALYTICS_KEY=mak_REPLACE_ME
# MANAGER_LOG_SOURCE=server
# NEXT_PUBLIC_MANAGER_ENDPOINT=https://your-manager-host
# NEXT_PUBLIC_MANAGER_APP_ID=resume-builder
# NEXT_PUBLIC_MANAGER_CLIENT_KEY=mck_REPLACE_ME
# NEXT_PUBLIC_MANAGER_ANALYTICS_KEY=mak_REPLACE_ME
# NEXT_PUBLIC_RELEASE=
# GIT_SHA=

# Standalone tools (read shell variables, not this file automatically).
# APP_ORIGIN=http://localhost:3000
# MANAGER_MODULE=../src/lib/manager/index.js
# MEASURE_CHUNK=20
# MEASURE_GAP_MS=100

# TEST_LOGIN_BYPASS is a temporary local-only switch, documented in README.md.
# Leave it unset in deployments. NODE_ENV/NEXT_RUNTIME/VERCEL_GIT_COMMIT_SHA are managed.
